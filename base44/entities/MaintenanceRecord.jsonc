{
  "name": "MaintenanceRecord",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data da manuten\u00e7\u00e3o"
    },
    "plate": {
      "type": "string",
      "description": "Placa do ve\u00edculo"
    },
    "vehicle_model": {
      "type": "string",
      "description": "Modelo do ve\u00edculo"
    },
    "category_name": {
      "type": "string",
      "description": "Categoria do ve\u00edculo"
    },
    "classification": {
      "type": "string",
      "description": "Classifica\u00e7\u00e3o (Preventivo/Corretivo)"
    },
    "cost_group": {
      "type": "string",
      "description": "Grupo de custo (Pe\u00e7as, Servi\u00e7os, etc)"
    },
    "cost_type": {
      "type": "string",
      "description": "Tipo de custo espec\u00edfico"
    },
    "supplier": {
      "type": "string",
      "description": "Fornecedor"
    },
    "invoice_number": {
      "type": "string",
      "description": "N\u00famero da nota fiscal"
    },
    "total_value": {
      "type": "number",
      "description": "Valor total"
    },
    "km": {
      "type": "number",
      "description": "Quilometragem"
    },
    "attachment_url": {
      "type": "string",
      "description": "URL do anexo (PDF ou imagem)"
    },
    "observation": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o"
    }
  },
  "required": [
    "date",
    "plate",
    "classification",
    "cost_group",
    "cost_type",
    "total_value"
  ]
}