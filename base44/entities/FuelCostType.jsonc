{
  "name": "FuelCostType",
  "type": "object",
  "properties": {
    "cost_name": {
      "type": "string",
      "description": "Nome do custo (ex: Combust\u00edveis)"
    },
    "cost_type": {
      "type": "string",
      "description": "Tipo de custo (ex: Diesel, Gasolina)"
    },
