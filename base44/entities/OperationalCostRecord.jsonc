{
  "name": "OperationalCostRecord",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data do lan\u00e7amento"
    },
    "cost_name": {
      "type": "string",
      "description": "Nome do custo operacional (v\u00ednculo com OperationalCost)"
    },
    "plate": {
      "type": "string",
      "description": "Placa do ve\u00edculo (opcional)"
    },
    "vehicle_model": {
      "type": "string",
      "description": "Modelo do ve\u00edculo"
    },
    "category_name": {
      "type": "string",
      "description": "Categoria do ve\u00edculo"
    },
    "supplier": {
      "type": "string",
      "description": "Fornecedor"
    },
    "invoice_number": {
      "type": "string",
      "description": "N\u00famero da nota fiscal"
    },
    "total_value": {
      "type": "number",
      "description": "Valor total"
    },
    "km": {
      "type": "number",
      "description": "Quilometragem"
    },
    "attachment_url": {
      "type": "string",
      "description": "URL do anexo (PDF ou imagem)"
    },
    "observation": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o"
    }
  },
  "required": [
    "date",
    "cost_name",
    "total_value"
  ]
}